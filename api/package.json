{
  "name": "pathfolio-api",
  "version": "1.0.0",
  "description": "PathfolioApp Onboarding & Student Lifecycle Express API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --watch-path=src --watch-path=.env --watch-preserve-output src/server.js",
