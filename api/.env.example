[TEMPLATE]
HOST=0.0.0.0
PORT=
NODE_ENV=development
USE_DATABASE=false
# Comma-separated exact browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@kiit.ac.in
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Pathfolio Administrator
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ------------------------------------------------------------------
# API authentication (separate frontend/backend hosting)
# ------------------------------------------------------------------
# Clients must present this shared key as `X-API-Key: <key>` (or
# `Authorization: Bearer <key>`) on every request. Keep it in sync with
# VITE_API_KEY in frontend/.env. Comma-separate API_KEY to allow several
# clients (e.g. web app + internal scripts). Leave EMPTY to disable the gate
# entirely (local/volatile development without any key).
API_KEY=
# Optional alias, same list semantics as API_KEY.
# API_KEYS=

# Session cookie flags for the pf_session cookie.
# Same-origin deployments (frontend and API on one domain) need nothing here.
# Separate-host deployments MUST set:
#   SESSION_COOKIE_SAMESITE=none
#   SESSION_COOKIE_SECURE=true
# (SameSite=None is rejected by browsers unless the cookie is Secure/HTTPS.)
# Defaults when unset: SameSite=Lax; Secure follows NODE_ENV=production.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------
# Email verification & SMTP delivery
# ------------------------------------------------------------------
# true  = registrations receive a time-limited verification link; the account is
#         only created after the link is opened (production-ready behaviour).
# false = development-friendly default: the institutional email format is still
#         validated server-side, but no verification email is sent.
STRICT_EMAIL_VERIFICATION=
# Minutes a verification token stays valid (default 60).
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# SMTP credentials used ONLY server-side. Never exposed to the frontend.
# The API degrades gracefully: if SMTP is not configured while strict
# verification is on, registration requests fail with a clear 503 error
# instead of silently skipping verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER when empty.
SMTP_FROM=

# Cloudinary signed uploads for TnP attachments and media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=pathfolio/tnp

# Cloudflare R2 object storage for resumes and document processing
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pathfolio-resumes
# Optional explicit endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=

# ------------------------------------------------------------------
# Google Gemini (JD Analyzer embeddings + Resume features)
# ------------------------------------------------------------------
# Get a free key at: https://aistudio.google.com/
# Used by:
#   - models/gemini-embedding-001 (768/3072 dims) for JD Analyzer semantic matching
#   - models/gemini-3.5-flash (with gemini-flash-latest fallback) to read uploaded
#     resume PDFs DIRECTLY (inline base64, no text conversion needed) and to
#     structure extracted resume text
# If omitted, parsing falls back to Groq, then deterministic regex extraction.
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Groq (Resume Parsing & Tailoring fallback)
# ------------------------------------------------------------------
# Get a free key at: https://console.groq.com/
# Tier-2 fallback for resume parsing and tailoring when Gemini is unavailable
# (text-based; PDFs are text-extracted server-side first).
# IMPORTANT: model IDs are key-specific. Verify with GET /openai/v1/models
# before setting GROQ_MODEL - e.g. some keys have llama-3.3-70b-versatile,
# others (like the current one) only gpt-oss / qwen chat models. The fallback
# lists in resumeAnalysis.js / tailorResume.service.js try openai/gpt-oss-120b
# before the legacy llama IDs.
GROQ_API_KEY=
# First model tried by every Groq tier. MUST exist on the key above.
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------
# Recruitment Intelligence AI provider (optional, free-tier by default)
# ------------------------------------------------------------------
# AI_PROVIDER: auto (default) | gemini | groq | none
#   auto       = use AI_API_KEY, else GEMINI_API_KEY, else GROQ_API_KEY
#   none       = disable every AI call; the app fully works without AI and
#                shows "AI analysis unavailable" with deterministic fallbacks.
# AI_MODEL overrides the default model (gemini-flash-latest / GROQ_MODEL).
# Never hardcode keys here — use api/.env (gitignored).
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=

# Story AI production controls (shared MySQL counters and expiring leases).
# Daily allowances reset at midnight IST (UTC+05:30).
# Viewing saved summaries and joining duplicate in-flight jobs do not use a job.
# These count generation jobs, including unsuccessful attempts. A job makes at
# most 3 bounded provider attempts; configure budgets for your actual provider quota.
# Maximum new generation jobs per student per IST day.
STORY_AI_DAILY_PER_STUDENT=5
# Shared daily total across ALL students using Story, not per student.
STORY_AI_DAILY_CAMPUS=1000
# Maximum simultaneous Story writing jobs; browsing is unaffected.
STORY_AI_CONCURRENCY=4
# Minimum interval between job starts for the same student.
STORY_AI_COOLDOWN_SECONDS=60
# Shared AI deadline: up to 12s Gemini + up to 8s Groq, below the 30s function limit.
STORY_AI_DEADLINE_MS=20000
# Pinned low-latency model with free-tier input/output. Optional second model
# must be available to your account and shares the same total deadline.
# Gemini candidates run before Groq when AI_PROVIDER=auto and no AI_API_KEY is set.
STORY_AI_GEMINI_MODELS=gemini-3.5-flash-lite

# Terminal logging: info shows Story lifecycle, model attempts, and cache reads.
# warn shows only limits/failures. Timestamps use IST (+05:30).
LOG_LEVEL=info
