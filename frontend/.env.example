# Pathfolio frontend environment
# ------------------------------------------------------------------
# Copy to frontend/.env and adjust per environment. Variables prefixed with
# VITE_ are embedded into the production JS bundle: never put true secrets
# here. The API key below is a shared APPLICATION key (identifies this app to
# the API), not a user secret; per-user authorization stays with the session
# cookie the backend issues on login.

# Vite host and port. Use 0.0.0.0 to accept connections on the server's
# network interfaces; the public URL is http://139.99.121.67:25613.
VITE_HOST=0.0.0.0
VITE_PORT=25613
# Comma-separated hostnames accepted by Vite.
VITE_ALLOWED_HOSTS=pathfolio.potenfyr.in

# Base URL of the backend API when hosted separately from the frontend.
# Empty (default) = same origin: requests go to /api/... (Vite dev proxy or
# the production reverse proxy / Vercel rewrite handles them).
# Separate hosting example: https://api.pathfolio.example.com
VITE_API_BASE_URL=http://api.pathfolio.potenfyr.in

# Backend target for the Vite development/preview proxy.
VITE_API_PROXY_TARGET=http://api.pathfolio.potenfyr.in

# Shared application key. Must equal API_KEY configured in api/.env on the
# backend. Sent by the app as an X-API-Key header on every API request.
# Leave empty in local development when the backend has no API_KEY set
# (the gate is disabled server-side in that case).
VITE_API_KEY=
