{
  "name": "pathfolio-app-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "PathfolioApp - Student Lifecycle & Career Portal (SLCP) - Landing Page & Onboarding Release",
  "scripts": {
    "dev": "concurrently --kill-others --names \"api,web\" --prefix-colors \"bgCyan.bold,bgMagenta.bold\" \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix api run dev",
    "install:all": "npm install && npm --prefix api install && npm --prefix frontend install && npm --prefix api run pdf:install-browser",
    "build": "npm --prefix frontend run build",
    "start": "concurrently --kill-others-on-fail --names \"api,web\" --prefix-colors \"bgCyan.bold,bgMagenta.bold\" \"npm run start:api\" \"npm run start:frontend\"",
    "start:api": "npm --prefix api start",
    "start:frontend": "npm --prefix frontend run preview",
    "preview": "npm --prefix frontend run preview",
    "check:copy": "node scripts/check-copy.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "student-lifecycle",
    "portfolio",
    "career-portal",
    "onboarding",
    "react",
    "vite",
    "express"
  ],
  "author": "PathfolioApp Team",
  "license": "MIT"
}
