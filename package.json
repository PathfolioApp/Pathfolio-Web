{
  "name": "pathfolio-app-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "PathfolioApp - Student Lifecycle & Career Portal (SLCP) - Landing Page & Onboarding Release",
  "scripts": {
    "dev": "concurrently --kill-others --names \"api,web\" --prefix-colors \"bgCyan.bold,bgMagenta.bold\" \"pnpm run dev:api\" \"pnpm run dev:frontend\"",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev:api": "pnpm --dir api run dev",
    "install:all": "pnpm install && pnpm --dir api install && pnpm --dir frontend install && pnpm --dir api run pdf:install-browser",
    "build": "pnpm --dir frontend run build",
    "build:frontend": "pnpm --dir frontend run build",
    "start": "concurrently --kill-others-on-fail --names \"api,web\" --prefix-colors \"bgCyan.bold,bgMagenta.bold\" \"pnpm run start:api\" \"pnpm run start:frontend\"",
    "start:api": "pnpm --dir api start",
    "start:frontend": "pnpm --dir frontend run preview",
    "prod": "pnpm run build && pnpm run start",
    "start:prod": "pnpm run start",
    "preview": "pnpm --dir frontend run preview",
    "check:copy": "node scripts/check-copy.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "student-lifecycle",
    "portfolio",
    "career-portal",
    "onboarding",
    "react",
    "vite",
    "express"
  ],
  "author": "PathfolioApp Team",
  "license": "MIT"
}
